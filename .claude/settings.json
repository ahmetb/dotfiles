{
  "cleanupPeriodDays": 99999,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "oh-my-posh claude --config ~/.claude.omp.yaml",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "plannotator@plannotator": true,
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(gofmt:*)"
    ],
  },
  "voiceEnabled": true,
  "_disabledHooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "node \"$HOME/.claude/hooks/notify.js\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$HOME/.claude/hooks/notify.js\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "_note": "Sound/notification hooks disabled. To re-enable, move these entries back into the \"hooks\" key above."
  },
  "mcpServers": {
    "playwright": {
      "args": [
        "@playwright/mcp@latest",
        "--extension"
      ],
      "command": "npx"
    }
  }
}
